// A single button that flips between dark and light, like the footer
// toggle on conn3x.org. Hidden until JavaScript can make it work.
---
<button type="button" class="c3-theme" hidden aria-label="Switch to the light theme">
  <svg class="sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  <svg class="moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7z"/></svg>
</button>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>(".c3-theme")) {
    const sync = () => {
      const light = document.documentElement.dataset.theme === "light";
      b.setAttribute("aria-label", light ? "Switch to the dark theme" : "Switch to the light theme");
    };
    b.hidden = false;
    sync();
    b.addEventListener("click", () => {
      const light = document.documentElement.dataset.theme !== "light";
      document.documentElement.dataset.theme = light ? "light" : "dark";
      try {
        localStorage.setItem("starlight-theme", light ? "light" : "dark");
      } catch {}
      document.querySelectorAll<HTMLButtonElement>(".c3-theme").forEach((x) => x.setAttribute("aria-label", light ? "Switch to the dark theme" : "Switch to the light theme"));
    });
  }
</script>

<style>
  .c3-theme {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .c3-theme:hover {
    color: var(--sl-color-white);
  }
  .c3-theme[hidden] {
    display: none;
  }
  .moon {
    display: none;
  }
  :global([data-theme="light"]) .c3-theme .sun {
    display: none;
  }
  :global([data-theme="light"]) .c3-theme .moon {
    display: block;
  }
</style>
