{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conn3x-site",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "conn3x.org", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
