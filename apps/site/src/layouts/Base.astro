import { Font } from "astro:assets";
import Seo from "../components/Seo.astro";
import "../brand/tokens.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
}

const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#07090d" />
    <script is:inline>try{if(localStorage.getItem("theme")==="light")document.documentElement.dataset.theme="light"}catch(e){}</script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-jetbrains" />
    <Seo {...props} />
  </head>
  <body>
    <slot />
    <script>
      // Diagrams marked data-play start when they scroll into view. Their
      // resting styles are the final frame, so nothing depends on this.
      const els = document.querySelectorAll("[data-play]");
      if (els.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("play");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.35 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
