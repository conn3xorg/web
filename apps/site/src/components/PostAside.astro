// Beside a blog post: what's on the page, then four ways to share it.
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  url: string;
  title: string;
}
const { headings, url, title } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
// Paths from Simple Icons (CC0).
const shares = [
  { name: "X", href: `https://x.com/intent/post?url=${u}&text=${t}`, d: "M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" },
  { name: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, d: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" },
  { name: "Reddit", href: `https://www.reddit.com/submit?url=${u}&title=${t}`, d: "M12 0C5.373 0 0 5.373 0 12c0 3.314 1.343 6.314 3.515 8.485l-2.286 2.286C.775 23.225 1.097 24 1.738 24H12c6.627 0 12-5.373 12-12S18.627 0 12 0Zm4.388 3.199c1.104 0 1.999.895 1.999 1.999 0 1.105-.895 2-1.999 2-.946 0-1.739-.657-1.947-1.539v.002c-1.147.162-2.032 1.15-2.032 2.341v.007c1.776.067 3.4.567 4.686 1.363.473-.363 1.064-.58 1.707-.58 1.547 0 2.802 1.254 2.802 2.802 0 1.117-.655 2.081-1.601 2.531-.088 3.256-3.637 5.876-7.997 5.876-4.361 0-7.905-2.617-7.998-5.87-.954-.447-1.614-1.415-1.614-2.538 0-1.548 1.255-2.802 2.803-2.802.645 0 1.239.218 1.712.585 1.275-.79 2.881-1.291 4.64-1.365v-.01c0-1.663 1.263-3.034 2.88-3.207.188-.911.993-1.595 1.959-1.595Zm-8.085 8.376c-.784 0-1.459.78-1.506 1.797-.047 1.016.64 1.429 1.426 1.429.786 0 1.371-.369 1.418-1.385.047-1.017-.553-1.841-1.338-1.841Zm7.406 0c-.786 0-1.385.824-1.338 1.841.047 1.017.634 1.385 1.418 1.385.785 0 1.473-.413 1.426-1.429-.046-1.017-.721-1.797-1.506-1.797Zm-3.703 4.013c-.974 0-1.907.048-2.77.135-.147.015-.241.168-.183.305.483 1.154 1.622 1.964 2.953 1.964 1.33 0 2.47-.81 2.953-1.964.057-.137-.037-.29-.184-.305-.863-.087-1.795-.135-2.769-.135Z" },
  { name: "Hacker News", href: `https://news.ycombinator.com/submitlink?u=${u}&t=${t}`, d: "M0 24V0h24v24H0zM6.951 5.896l4.112 7.708v5.064h1.583v-4.972l4.148-7.799h-1.749l-2.457 4.875c-.372.745-.688 1.434-.688 1.434s-.297-.708-.651-1.434L8.831 5.896h-1.88z" },
];
---
<aside class="post-aside">
  {toc.length > 1 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p class="label" id="toc-title">On this page</p>
      <ol>
        {toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}
      </ol>
    </nav>
  )}
  <div class="share">
    <p class="label">Share</p>
    <ul>
      {shares.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.name}`} title={`Share on ${s.name}`}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d={s.d} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<script>
  // Mark the section being read in "On this page".
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>("[data-toc]")].map((a) => [a.dataset.toc!, a]),
  );
  const heads = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  if (heads.length) {
    const mark = () => {
      let current = heads[0];
      for (const h of heads) if (h.getBoundingClientRect().top < 140) current = h;
      links.forEach((a, id) => a.toggleAttribute("aria-current", id === current.id));
    };
    addEventListener("scroll", mark, { passive: true });
    mark();
  }
</script>

<style>
  .post-aside {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }
  .toc {
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
  }
  .toc ol {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--c-border);
    display: grid;
    gap: 0.55rem;
  }
  .toc a {
    position: relative;
    display: block;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--c-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--c-text);
  }
  .toc a[aria-current]::before {
    content: "";
    position: absolute;
    left: calc(-0.9rem - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--c-accent);
  }
  .share ul {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 2.75rem);
    gap: 0.6rem;
  }
  .share a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--c-border);
    border-radius: 8px;
    background: var(--c-surface);
    color: var(--c-text-muted);
    transition: color 0.15s, border-color 0.15s, transform 0.2s var(--ease-out);
  }
  .share a:hover {
    color: var(--c-text);
    border-color: var(--c-accent);
    transform: translateY(-2px);
  }
</style>
