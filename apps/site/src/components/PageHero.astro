// The top of every inner page: a label, a big title, a lead, and room for
// actions, over a faint grid that glows orange at the top.
interface Props {
  label: string;
  title: string;
}
const { label, title } = Astro.props;

// The home page's honeycomb, held still: a grid drawn by a CSS mask (the
// cell below, edge 26), and a few lit traces on it, anchored to the right
// edge so they sit on the grid.
const e = 26, h = Math.sqrt(3) * e, W = 3 * e * 10;
// Each trace: start column and row, then up (1) or down (0) for each turn.
const trace = (col: number, row: number, turns: number[]) => {
  let x = 3 * e * col, y = h / 2 + h * row, d = `M${x} ${y.toFixed(1)}`;
  for (const up of turns) {
    x += e / 2;
    y += up ? -h / 2 : h / 2;
    d += `L${x} ${y.toFixed(1)}H${(x += e)}`;
  }
  return { d, x, y };
};
const traces = [trace(1, 1, [1, 0, 0, 1, 0, 1, 1]), trace(5, 2, [0, 1, 1, 0, 0, 1]), trace(8, 0, [0, 1, 0, 0, 1])];
---
<header class="page-hero">
  <span class="hex" aria-hidden="true"></span>
  <svg class="lit" viewBox={`0 0 ${W} 300`} width={W} height="300" aria-hidden="true">
    {traces.map((t) => (
      <>
        <path d={t.d} />
        <circle cx={t.x} cy={t.y} r="4" />
      </>
    ))}
  </svg>
  <div class="wrap">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    <div class="lead-in"><slot /></div>
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(5rem, 11vw, 8rem) clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--c-border);
    overflow: hidden;
    background:
      radial-gradient(46rem 20rem at 80% 0%, color-mix(in srgb, var(--c-accent) 13%, transparent), transparent 70%),
      var(--c-bg);
  }
  .hex,
  .lit {
    position: absolute;
    top: 0;
    right: 0;
    pointer-events: none;
  }
  .hex {
    left: 0;
    bottom: 0;
    background: var(--c-border);
    -webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2278%22%20height%3D%2245.03%22%3E%3Cpath%20d%3D%22M0%2022.52L13%200H39L52%2022.52H78M52%2022.52L39%2045.03H13L0%2022.52%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%2F%3E%3C%2Fsvg%3E") right top / auto repeat, radial-gradient(70% 100% at 80% 0%, #000 20%, transparent 75%);
    -webkit-mask-composite: source-in;
    mask: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2278%22%20height%3D%2245.03%22%3E%3Cpath%20d%3D%22M0%2022.52L13%200H39L52%2022.52H78M52%2022.52L39%2045.03H13L0%2022.52%22%20fill%3D%22none%22%20stroke%3D%22%23000%22%2F%3E%3C%2Fsvg%3E") right top / auto repeat, radial-gradient(70% 100% at 80% 0%, #000 20%, transparent 75%);
    mask-composite: intersect;
  }
  .lit {
    opacity: 0.75;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%);
    mask-image: linear-gradient(90deg, transparent, #000 40%);
  }
  .lit path {
    fill: none;
    stroke: color-mix(in srgb, var(--c-accent) 55%, var(--c-border));
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .lit circle {
    fill: var(--c-accent);
  }
  .page-hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 60%;
    background: linear-gradient(transparent, var(--c-bg));
    pointer-events: none;
  }
  .wrap {
    position: relative;
    z-index: 1;
  }
  h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.04em;
    margin: 1.25rem 0 1.25rem;
  }
  .lead-in {
    max-width: 44rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--c-text-muted);
  }
  .lead-in :global(p) {
    margin: 0;
  }
  .lead-in :global(code) {
    color: var(--c-text);
  }
</style>
