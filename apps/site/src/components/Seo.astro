---
// Copyright (c) The Conn3x Authors
// SPDX-License-Identifier: MPL-2.0
interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, path, image = "/og.png", imageAlt } = Astro.props;
const site = "https://conn3x.org";
const url = new URL(path, site).href;
const imageUrl = new URL(image, site).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Conn3x",
    url: site,
    logo: `${site}/logo.png`,
    sameAs: ["https://github.com/conn3xorg", "https://x.com/conn3xone"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Conn3x",
    url: site,
  },
];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Conn3x" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@conn3xone" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
<link rel="alternate" type="text/markdown" href="/llms.txt" title="LLM-friendly summary" />
<link rel="sitemap" href="/sitemap-index.xml" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
