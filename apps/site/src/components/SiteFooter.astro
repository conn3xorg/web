---
// Copyright (c) The Conn3x Authors
// SPDX-License-Identifier: MPL-2.0
import mark from "../brand/mark-dark.svg?raw";
import markLight from "../brand/mark.svg?raw";

const year = new Date().getFullYear();
const repo = "https://github.com/conn3xorg/conn3x";
const docs = "https://docs.conn3x.org";
const columns = [
  ["Product", [["Circuits", "/circuits"], ["Providers", "/providers"], ["FAQ", "/faq"], ["Releases", `${repo}/releases`]]],
  ["Docs", [["Get started", `${docs}/get-started`], ["Install", `${docs}/install`], ["Modules", `${docs}/modules/file`], ["CLI", `${docs}/reference/cli`]]],
  ["Community", [["GitHub", repo], ["Discussions", `${repo}/discussions`], ["X", "https://x.com/conn3xone"], ["Blog", "/blog"], ["RSS", "/rss.xml"]]],
  ["Project", [["Contribute", `${repo}/blob/main/CONTRIBUTING.md`], ["Governance", `${repo}/blob/main/GOVERNANCE.md`], ["Security", `${repo}/blob/main/SECURITY.md`], ["License", `${repo}/blob/main/LICENSE`]]],
] as const;
---
<footer class="site-footer">
  <div class="wrap top">
    <div class="about">
      <span class="mark mark-dark" set:html={mark} />
      <span class="mark mark-light" set:html={markLight} />
      <p>One plan for your cloud and the servers it creates. Open source, built on OpenTofu.</p>
      <button class="theme" type="button" hidden aria-label="Switch to the light theme">
        <svg class="sun" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="currentColor"/><path d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6L13 13M3 13l1.4-1.4M11.6 4.4L13 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
        <svg class="moon" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path fill="currentColor" d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7z"/></svg>
        <span class="tl">Light theme</span>
      </button>
    </div>
    {columns.map(([title, items]) => (
      <nav aria-label={title}>
        <p class="h">{title}</p>
        <ul>
          {items.map(([t, h]) => <li><a href={h}>{t}</a></li>)}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap bottom">
    <p>© {year} The Conn3x Authors. Licensed under <span class="nowrap">MPL-2.0</span>.</p>
    <p>Built on <a href="https://opentofu.org">OpenTofu</a>.</p>
  </div>
</footer>

<script>
  const button = document.querySelector<HTMLButtonElement>(".site-footer .theme");
  if (button) {
    const label = button.querySelector(".tl")!;
    const sync = () => {
      const light = document.documentElement.dataset.theme === "light";
      label.textContent = light ? "Dark theme" : "Light theme";
      button.setAttribute("aria-label", light ? "Switch to the dark theme" : "Switch to the light theme");
    };
    button.hidden = false;
    sync();
    button.addEventListener("click", () => {
      const light = document.documentElement.dataset.theme !== "light";
      if (light) document.documentElement.dataset.theme = "light";
      else delete document.documentElement.dataset.theme;
      try {
        localStorage.setItem("theme", light ? "light" : "dark");
      } catch {}
      sync();
    });
  }
</script>

<style>
  .site-footer {
    margin-top: clamp(5rem, 10vw, 8rem);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-muted);
    font-size: 0.875rem;
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr));
    gap: 2rem;
    padding-block: 3.5rem 3rem;
  }
  .about p {
    max-width: 18rem;
    margin: 1rem 0 1.25rem;
  }
  .mark {
    display: block;
    width: 2rem;
  }
  .mark :global(svg) {
    width: 100%;
    height: auto;
  }
  .mark-light {
    display: none;
  }
  :global(:root[data-theme="light"]) .mark-light {
    display: block;
  }
  :global(:root[data-theme="light"]) .mark-dark {
    display: none;
  }
  .h {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-text);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  a {
    color: var(--c-text-muted);
    text-decoration: none;
  }
  a:hover {
    color: var(--c-text);
  }
  .theme {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--c-border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--c-text-muted);
    font: inherit;
    cursor: pointer;
  }
  .theme:hover {
    color: var(--c-text);
  }
  .theme[hidden] {
    display: none;
  }
  .moon {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme .sun {
    display: none;
  }
  :global(:root[data-theme="light"]) .theme .moon {
    display: block;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--c-border);
  }
  .bottom p {
    margin: 0;
  }
  .bottom a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .nowrap {
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
