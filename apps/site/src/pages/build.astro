---
// Copyright (c) The Conn3x Authors
// SPDX-License-Identifier: MPL-2.0
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageHero from "../components/PageHero.astro";
import categoryList from "../data/categories.json";
import builder from "../data/builder.json";

type Circuit = { name: string; description: string; version: string; category: string; official: boolean };
const files = import.meta.glob<{ default: Circuit }>("../data/circuits/*.json", { eager: true });
const inputs = import.meta.glob("../data/circuit-inputs/*.json");
const offered = new Set(Object.keys(inputs).map((p) => p.split("/").pop()!.replace(".json", "")));
const all = Object.values(files).map((f) => f.default);
const excluded = builder.excluded as Record<string, string>;
const circuits = all
  .filter((c) => c.official && offered.has(c.name) && !excluded[c.name])
  .sort((a, b) => a.name.localeCompare(b.name));
const groups = categoryList
  .map((k) => [k, circuits.filter((c) => c.category === k)] as const)
  .filter(([, cs]) => cs.length);
const left = Object.entries(excluded).filter(([n]) => all.some((c) => c.name === n));
---
<Base
  title="Circuit Builder: Conn3x"
  description="Pick a distribution and the circuits you want, and get a Conn3x config with every circuit pinned, secrets kept out of it and the firewall opened for what you picked."
  path="/build"
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <PageHero label="Circuit Builder" title="Pick the parts. Get a config you can run.">
      <p>
        Choose a distribution and the circuits you want on a group of servers. You get a <code>main.tf</code> with each circuit pinned to its release, passwords kept out of it, and
        the firewall opened for what you picked. It's written in your browser, and nothing you type
        leaves it.
      </p>
    </PageHero>

    <form class="wrap page" id="build" novalidate>
      <noscript><p class="note">The builder needs JavaScript. Every circuit's README has a working example too.</p></noscript>

      <section aria-labelledby="s-distro">
        <h2 id="s-distro"><span>1</span> Distribution</h2>
        <div class="chips" role="radiogroup" aria-labelledby="s-distro">
          {builder.distros.map((d, i) => (
            <label class="chip"><input type="radio" name="distro" value={d.id} checked={i === 0} /> {d.name}</label>
          ))}
        </div>
      </section>

      <section aria-labelledby="s-circuits">
        <h2 id="s-circuits"><span>2</span> Circuits</h2>
        <p class="sub">Two circuits that want the same port can't share a host, so picking one greys out the other and says why.</p>
        {groups.map(([k, cs]) => (
          <fieldset class="group">
            <legend>{k}</legend>
            <div class="chips">
              {cs.map((c) => (
                <label class="chip" title={c.description}><input type="checkbox" name="pick" value={c.name} /> {c.name}</label>
              ))}
            </div>
            <ul class="why" data-why={k}></ul>
          </fieldset>
        ))}
        {left.length > 0 && (
          <details class="later">
            <summary>Not in the builder yet ({left.length})</summary>
            <ul>
              {left.map(([n, why]) => (
                <li><a href={`https://docs.conn3x.org/circuits/${n}`}>{n}</a>: {why}</li>
              ))}
            </ul>
          </details>
        )}
      </section>

      <section aria-labelledby="s-hosts">
        <h2 id="s-hosts"><span>3</span> Servers</h2>
        <div class="fields">
          <fieldset class="group wide">
            <legend>Where are they?</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="where" value="own" checked /> I have them already</label>
              <label class="chip"><input type="radio" name="where" value="digitalocean" /> Create them on DigitalOcean</label>
              <label class="chip"><input type="radio" name="where" value="gcp" /> Create them on Google Cloud</label>
              <label class="chip"><input type="radio" name="where" value="aws" /> Create them on AWS</label>
            </div>
          </fieldset>
          <div class="fields wide" id="cloud-fields" hidden>
            <label class="field wide" id="cloud-project-field" hidden>
              <span>Project ID (needed)</span>
              <input id="cloud-project" type="text" placeholder="my-project-123" spellcheck="false" autocomplete="off" />
            </label>
            <label class="field wide">
              <span>Addresses that can reach SSH, one per line (needed)</span>
              <textarea id="cloud-admin" rows="2" spellcheck="false" autocomplete="off" placeholder="203.0.113.7/32"></textarea>
              <small>Your own public address, as a network. The cloud firewall keeps everyone else off port 22.</small>
            </label>
            <label class="field">
              <span id="cloud-region-label">Region</span>
              <input id="cloud-region" type="text" placeholder="lon1" spellcheck="false" autocomplete="off" />
            </label>
            <label class="field">
              <span id="cloud-size-label">Size</span>
              <input id="cloud-size" type="text" placeholder="s-2vcpu-4gb" spellcheck="false" autocomplete="off" />
            </label>
            <label class="field">
              <span>Public key file</span>
              <input id="cloud-key" type="text" placeholder="~/.ssh/id_ed25519.pub" spellcheck="false" autocomplete="off" />
            </label>
            <label class="field">
              <span id="cloud-tags-label">Tags, one per line</span>
              <textarea id="cloud-tags" rows="1" spellcheck="false" autocomplete="off"></textarea>
            </label>
            <small class="wide" id="cloud-note"></small>
          </div>
          <label class="field wide" id="hosts-field">
            <span id="hosts-label">Hosts, one per line</span>
            <textarea id="hosts" rows="3" spellcheck="false" autocomplete="off" placeholder={"web1 203.0.113.10\nweb2 203.0.113.11"}></textarea>
            <small id="hosts-help">A name and an address, or just the address. Every circuit runs on all of them, except the ones that ask for hosts by role.</small>
          </label>
          <label class="field" data-own>
            <span>SSH user</span>
            <input id="ssh-user" type="text" placeholder="root" spellcheck="false" autocomplete="off" />
          </label>
          <label class="field">
            <span>Private key file</span>
            <input id="ssh-key" type="text" placeholder="the SSH agent" spellcheck="false" autocomplete="off" />
          </label>
          <label class="field" data-own>
            <span>known_hosts file</span>
            <input id="ssh-known" type="text" placeholder="~/.ssh/known_hosts" spellcheck="false" autocomplete="off" />
          </label>
          <label class="check" data-own>
            <input id="ssh-become" type="checkbox" />
            <span>Use sudo. Tick this when the user isn't root.</span>
          </label>
          <label class="field wide" id="network-field" hidden>
            <span>Your network, for the firewall</span>
            <input id="network" type="text" placeholder="192.168.1.0/24" spellcheck="false" autocomplete="off" />
            <small id="network-help"></small>
          </label>
        </div>
      </section>

      <section aria-labelledby="s-settings" id="settings-section" hidden>
        <h2 id="s-settings"><span>4</span> Settings</h2>
        <p class="sub">Only what each circuit can't do without. The rest is under More settings, with the circuit's own defaults.</p>
        <div id="settings"></div>
      </section>

      <div class="go">
        <button class="btn" type="submit" id="write">Write my config</button>
        <button class="btn btn-ghost" type="button" id="share">Copy a link to these picks</button>
        <span class="sub" id="count"></span>
      </div>
      <p class="sub share-note">The link holds your distribution and picks. Nothing you've typed goes in it, and whoever opens it still ticks any licence for themselves.</p>

      <section id="out" aria-labelledby="s-out" hidden>
        <h2 id="s-out">Your config</h2>
        <div id="errors" class="errors" role="alert" hidden></div>
        <div id="result" hidden>
          <p class="sub">Save these in a folder, then follow README.md. Nothing has touched your servers yet.</p>
          <div class="panel code">
            <div class="tabs" role="tablist" aria-label="Files" id="tabs"></div>
            <pre tabindex="0"><code id="code"></code></pre>
          </div>
          <div class="actions">
            <button class="btn btn-ghost" type="button" id="copy">Copy this file</button>
            <button class="btn" type="button" id="zip">Download all as a zip</button>
          </div>
        </div>
      </section>
    </form>
  </main>

  <SiteFooter />
</Base>

<script>
  import { generate, unavailable, conflict, withRequired, wiring, unticked, parseType, fieldKind, secret, varName, zip, linkFor, readLink, rolesOf, clouds } from "../lib/builder.js";
  import builder from "../data/builder.json";

  const load = (g: Record<string, { default: any }>) =>
    Object.fromEntries(Object.values(g).map((m) => [m.default.name, m.default]));
  const data = {
    builder,
    circuits: load(import.meta.glob("../data/circuits/*.json", { eager: true })),
    inputs: load(import.meta.glob("../data/circuit-inputs/*.json", { eager: true })),
  };

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>("build");
  const picks = [...form.querySelectorAll<HTMLInputElement>('input[name="pick"]')];
  const values: Record<string, any> = {};
  let shown = false;
  let files: Record<string, string> = {};
  let current = "main.tf";

  const where = () => form.querySelector<HTMLInputElement>('input[name="where"]:checked')!.value;
  const creating = () => where() !== "own";
  const distro = () => form.querySelector<HTMLInputElement>('input[name="distro"]:checked')!.value;
  const picked = () => picks.filter((p) => p.checked).map((p) => p.value);

  const el = (tag: string, props: Record<string, any> = {}, ...kids: (Node | string)[]) => {
    const e = Object.assign(document.createElement(tag), props);
    e.append(...kids);
    return e;
  };

  // Grey out what can't be picked, and say why under each category.
  function refresh() {
    const d = distro();
    const chosen = picked();
    const extra = withRequired(data, chosen).filter((n) => !chosen.includes(n));
    const why: Record<string, string[]> = {};
    for (const p of picks) {
      const reason = unavailable(data, p.value, d) ?? (p.checked ? null : conflict(data, p.value, chosen));
      if (reason && p.checked) p.checked = false;
      p.disabled = !!reason;
      const cat = data.circuits[p.value].category;
      if (reason) (why[cat] ??= []).push(`${p.value}: ${reason}`);
      if (extra.includes(p.value)) (why[cat] ??= []).push(`${p.value} comes along: ${chosen.filter((c) => withRequired(data, [c]).includes(p.value)).join(", ")} needs it.`);
    }
    for (const ul of form.querySelectorAll<HTMLElement>("[data-why]")) {
      ul.replaceChildren(...(why[ul.dataset.why!] ?? []).map((t) => el("li", {}, t)));
    }
    renderSettings(withRequired(data, picked()));
  }

  let rendered = "";
  function renderSettings(names: string[]) {
    const fw = names.includes("firewall");
    $("hosts-field").hidden = names.length > 0 && names.every((n) => rolesOf(data, n).length);
    const priv = names.flatMap((n) => (builder.ports as any)[n] ?? []).filter((p: any) => p.private);
    $("network-field").hidden = !((fw || creating()) && priv.length);
    $("cloud-fields").hidden = !creating();
    if (creating()) {
      const c = (clouds as any)[where()];
      $("cloud-project-field").hidden = !c.projectOk;
      $("cloud-region-label").textContent = c.regionLabel;
      $("cloud-size-label").textContent = c.sizeLabel;
      $("cloud-tags-label").textContent = c.tagsLabel;
      $<HTMLInputElement>("cloud-region").placeholder = c.region;
      $<HTMLInputElement>("cloud-size").placeholder = c.size;
      $<HTMLTextAreaElement>("cloud-tags").placeholder = c.tagsHolder;
      $("cloud-note").textContent = c.note;
    }
    $<HTMLTextAreaElement>("hosts").placeholder = creating() ? "web1\nweb2" : "web1 203.0.113.10\nweb2 203.0.113.11";
    for (const e of form.querySelectorAll<HTMLElement>("[data-own]")) e.hidden = creating();
    $("hosts-help").textContent = creating()
      ? "A name for each new server. Every circuit runs on all of them, except the ones that ask for hosts by role."
      : "A name and an address, or just the address. Every circuit runs on all of them, except the ones that ask for hosts by role.";
    for (const e of form.querySelectorAll<HTMLTextAreaElement>("[data-role]")) e.placeholder = creating() ? `${e.dataset.role}1` : `${e.dataset.role}1 203.0.113.10`;
    $("network-help").textContent = priv.length
      ? `Opens ${names.flatMap((n) => ((builder.ports as any)[n] ?? []).filter((p: any) => p.private).map((p: any) => `${p.port} (${n})`)).join(", ")} to this network only. Leave it empty to keep them closed.`
      : "";
    $("count").dataset.n = names.length ? `${names.length} circuit${names.length === 1 ? "" : "s"}` : "";
    const key = names.join(",");
    if (key === rendered) return;
    rendered = key;
    $("settings-section").hidden = !names.length;
    $("settings").replaceChildren(...names.map(card));
  }

  function field(circuit: string, v: any) {
    const t = parseType(v.type);
    const kind = fieldKind(t)!;
    const k = `${circuit}.${v.name}`;
    const id = `f-${circuit}-${v.name}`;
    const shownDefault = v.default === undefined || v.default === null ? "" : typeof v.default === "object" ? JSON.stringify(v.default) : String(v.default);
    const label = (extra?: string) => el("span", {}, el("code", {}, v.name), extra ? ` ${extra}` : "");
    const help = el("small", {}, v.description);
    if (kind === "bool") {
      const box = el("input", { type: "checkbox", id, checked: values[k] ?? v.default ?? false }) as HTMLInputElement;
      box.dataset.key = k;
      return el("label", { className: "check" }, box, el("span", {}, el("code", {}, v.name), ` ${v.description}`));
    }
    if (kind === "entry") {
      const raw = (values[k] ??= { key: "", fields: {} });
      const name = el("input", { type: "text", id, value: raw.key, placeholder: "a name, such as site", spellcheck: false, autocomplete: "off" }) as HTMLInputElement;
      name.dataset.key = k;
      name.dataset.part = "key";
      const box = el("fieldset", { className: "entry" }, el("legend", {}, el("code", {}, v.name), v.required ? "" : " (optional)"), help, el("label", { className: "field" }, el("span", {}, "Name"), name));
      for (const f of t.of.fields) {
        const fk = fieldKind(f.type);
        const input = (fk === "bool"
          ? el("input", { type: "checkbox", checked: !!raw.fields[f.name] })
          : el(fk === "lines" ? "textarea" : "input", { value: raw.fields[f.name] ?? "", rows: 2, spellcheck: false, autocomplete: "off", placeholder: fk === "lines" ? "one per line" : f.optional ? "optional" : "" })) as HTMLInputElement;
        input.dataset.key = k;
        input.dataset.part = f.name;
        box.append(el("label", { className: fk === "bool" ? "check" : "field" }, ...(fk === "bool" ? [input, el("span", {}, el("code", {}, f.name))] : [el("span", {}, el("code", {}, f.name), f.optional ? "" : " (needed)"), input])));
      }
      return box;
    }
    const choices: string[] | undefined = (builder as any).choices?.[circuit]?.[v.name];
    if (choices) {
      const sel = el("select", { id }, ...choices.map((c) => el("option", { value: c, selected: (values[k] ?? v.default) === c }, c))) as HTMLSelectElement;
      sel.dataset.key = k;
      return el("label", { className: "field" }, label(), sel, help);
    }
    const multi = kind === "lines" || kind === "pairs" || (kind === "string" && String(v.default ?? "").includes("\n"));
    const input = el(multi ? "textarea" : "input", {
      id,
      value: values[k] ?? "",
      placeholder: kind === "pairs" ? "name = value, one per line" : kind === "lines" ? "one per line" : shownDefault,
      spellcheck: false,
      autocomplete: "off",
      rows: 3,
      ...(kind === "number" ? { inputMode: "numeric" } : {}),
    }) as HTMLInputElement;
    input.dataset.key = k;
    return el("label", { className: "field" }, label(v.required ? "(needed)" : ""), input, help);
  }

  function roleField(circuit: string, r: any) {
    const k = `${circuit}.${r.input}`;
    const input = el("textarea", { id: `f-${circuit}-${r.input}`, value: values[k] ?? "", rows: 3, spellcheck: false, autocomplete: "off", placeholder: `${r.prefix}1 203.0.113.10` }) as HTMLTextAreaElement;
    input.dataset.key = k;
    input.dataset.role = r.prefix;
    if (creating()) input.placeholder = `${r.prefix}1`;
    return el("label", { className: "field" }, el("span", {}, `${r.label}${r.one ? "" : ", one per line"}`, r.min ? " (needed)" : ""), input, el("small", {}, r.help));
  }

  function card(name: string) {
    const c = data.circuits[name];
    const wired: Record<string, unknown> = (wiring(data, withRequired(data, picked())).values as any)[name] ?? {};
    const roles = rolesOf(data, name);
    const ins = data.inputs[name].inputs.filter((v: any) => !(name === "firewall" && v.name === "allow") && !(v.name in wired) && !roles.some((r: any) => r.input === v.name));
    const needed = ins.filter((v: any) => v.required && !secret(v));
    const secrets = ins.filter((v: any) => v.required && secret(v));
    const more = ins.filter((v: any) => !v.required && !secret(v) && fieldKind(parseType(v.type)));
    const elsewhere = ins.filter((v: any) => !v.required && (secret(v) || !fieldKind(parseType(v.type))));
    const box = el("article", { className: "card" },
      el("div", { className: "top" }, el("h3", {}, name), el("span", { className: "ver" }, c.version), el("a", { href: `https://docs.conn3x.org/circuits/${name}` }, "Docs")),
      el("p", { className: "desc" }, c.description),
    );
    const hint = (builder.hints as any)[name];
    if (hint) box.append(el("p", { className: "hint" }, hint));
    const set = Object.keys(wired);
    if (set.length) box.append(el("p", { className: "hint" }, "The builder sets ", ...set.flatMap((k, i) => [i ? ", " : "", el("code", {}, k)]), " to match your other picks."));
    for (const r of roles) box.append(roleField(name, r));
    for (const v of needed) box.append(field(name, v));
    for (const v of secrets) box.append(el("p", { className: "secret" }, el("code", {}, v.name), ` is a secret, so it isn't asked for here. You'll set it as `, el("code", {}, `TF_VAR_${varName(name, v.name)}`), " when you run it."));
    if (!needed.length && !secrets.length && !roles.length) box.append(el("p", { className: "sub" }, "Nothing needed. It works with its defaults."));
    if (more.length || elsewhere.length) {
      const d = el("details", { className: "more" }, el("summary", {}, `More settings (${more.length})`), ...more.map((v: any) => field(name, v)));
      if (elsewhere.length) d.append(el("p", { className: "sub" }, "Also takes ", ...elsewhere.flatMap((v: any, i: number) => [i ? ", " : "", el("code", {}, v.name)]), ". Set those in main.tf afterwards; the docs show how."));
      box.append(d);
    }
    return box;
  }

  form.addEventListener("input", (e) => {
    const t = e.target as HTMLInputElement;
    const k = t.dataset.key;
    if (k) {
      const v = t.type === "checkbox" ? t.checked : t.value;
      if (t.dataset.part === "key") values[k].key = v;
      else if (t.dataset.part) values[k].fields[t.dataset.part] = v;
      else values[k] = v;
    }
    if (t.name === "where") refresh();
    if (t.name === "pick" || t.name === "distro") {
      refresh();
      history.replaceState(null, "", linkFor(distro(), picked()));
    }
    gate();
    if (shown) write();
  });

  // The button waits for boxes only a person may tick, such as a licence.
  function gate() {
    const left = unticked(data, picked(), values);
    $<HTMLButtonElement>("write").disabled = left.length > 0;
    $("count").textContent = left.length
      ? `Tick ${left.map((k) => k.replace(".", "'s ")).join(" and ")} first.`
      : $("count").dataset.n ?? "";
  }

  function build() {
    return {
      distro: distro(),
      picks: picked(),
      hosts: $<HTMLTextAreaElement>("hosts").value,
      ssh: {
        user: $<HTMLInputElement>("ssh-user").value,
        key: $<HTMLInputElement>("ssh-key").value,
        knownHosts: $<HTMLInputElement>("ssh-known").value,
        become: $<HTMLInputElement>("ssh-become").checked,
      },
      values,
      network: $("network-field").hidden ? "" : $<HTMLInputElement>("network").value,
      cloud: creating()
        ? {
            provider: where(),
            project: $<HTMLInputElement>("cloud-project").value,
            adminCidrs: $<HTMLTextAreaElement>("cloud-admin").value,
            region: $<HTMLInputElement>("cloud-region").value,
            size: $<HTMLInputElement>("cloud-size").value,
            publicKey: $<HTMLInputElement>("cloud-key").value,
            tags: $<HTMLTextAreaElement>("cloud-tags").value,
          }
        : undefined,
    };
  }

  // Comments, strings, attribute names and keywords; everything is escaped.
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[c]!);
  const span = (cls: string, s: string) => `<span class="${cls}">${esc(s)}</span>`;
  const tokens = /(#[^\n]*)|("(?:[^"\\\n]|\\.)*")|^([ \t]*)([A-Za-z_][\w-]*)(?=\s+=)|\b(module|locals|variable|true|false|null)\b/gm;
  const highlight = (s: string) => {
    let out = "";
    let at = 0;
    for (const m of s.matchAll(tokens)) {
      const [all, c, str, sp, name, kw] = m;
      out += esc(s.slice(at, m.index)) + (c ? span("c", c) : str ? span("s", str) : name ? esc(sp) + span("a", name) : span("k", kw));
      at = m.index! + all.length;
    }
    return out + esc(s.slice(at));
  };

  function show(name: string) {
    current = name;
    for (const b of $("tabs").querySelectorAll<HTMLButtonElement>("button")) b.setAttribute("aria-selected", String(b.dataset.file === name));
    const code = $("code");
    if (name.endsWith(".tf")) code.innerHTML = highlight(files[name]);
    else code.textContent = files[name];
  }

  function write() {
    const r = generate(data, build());
    $("out").hidden = false;
    for (const f of form.querySelectorAll("[aria-invalid]")) f.removeAttribute("aria-invalid");
    if (r.errors) {
      $("result").hidden = true;
      const box = $("errors");
      box.hidden = false;
      box.replaceChildren(
        el("p", {}, "A few things to fix first:"),
        el("ul", {}, ...r.errors.map(([f, msg]: [string, string]) => {
          const target = f === "hosts" ? "hosts" : f === "ssh.user" ? "ssh-user" : f === "network" ? "network" : f === "cloud.adminCidrs" ? "cloud-admin" : f === "cloud.region" ? "cloud-region" : f === "cloud.size" ? "cloud-size" : f === "cloud.project" ? "cloud-project" : f === "cloud.tags" ? "cloud-tags" : f === "cloud" ? "s-distro" : f.includes(".") ? `f-${f.replace(".", "-")}` : "s-circuits";
          document.getElementById(target)?.setAttribute("aria-invalid", "true");
          return el("li", {}, el("a", { href: `#${target}` }, f.includes(".") && f !== "ssh.user" && !f.startsWith("cloud") ? f : f === "cloud" ? "Distribution" : f.startsWith("cloud") ? f.slice(6) : f === "picks" ? "Circuits" : f), `: ${msg}`);
        })),
      );
      return;
    }
    $("errors").hidden = true;
    $("result").hidden = false;
    files = r.files;
    if (!files[current]) current = "main.tf";
    $("tabs").replaceChildren(...Object.keys(files).map((f) => {
      const b = el("button", { type: "button", role: "tab", textContent: f }) as HTMLButtonElement;
      b.dataset.file = f;
      b.addEventListener("click", () => show(f));
      return b;
    }));
    show(current);
  }

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    shown = true;
    write();
    $("out").scrollIntoView({ behavior: "smooth", block: "start" });
  });

  $("copy").addEventListener("click", async () => {
    const b = $("copy");
    try {
      await navigator.clipboard.writeText(files[current]);
      b.textContent = "Copied";
    } catch {
      b.textContent = "Select and copy";
    }
    setTimeout(() => (b.textContent = "Copy this file"), 1500);
  });

  $("zip").addEventListener("click", () => {
    const url = URL.createObjectURL(new Blob([zip(files)], { type: "application/zip" }));
    const a = el("a", { href: url, download: "conn3x-config.zip" });
    a.click();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
  });

  $("share").addEventListener("click", async () => {
    const b = $("share");
    const url = new URL(linkFor(distro(), picked()), location.href).href;
    try {
      await navigator.clipboard.writeText(url);
      b.textContent = "Link copied";
    } catch {
      b.textContent = "Copy it from the address bar";
    }
    setTimeout(() => (b.textContent = "Copy a link to these picks"), 1500);
  });

  // Links inside the page, such as an error's, change the fragment too. Those aren't builds.
  function openLink() {
    const link = readLink(data, location.hash);
    if (!link) return;
    form.querySelector<HTMLInputElement>(`input[name="distro"][value="${link.distro}"]`)!.checked = true;
    for (const p of picks) p.checked = link.picks.includes(p.value);
  }
  addEventListener("hashchange", () => {
    openLink();
    refresh();
    gate();
    if (shown) write();
  });

  openLink();
  refresh();
  gate();
</script>

