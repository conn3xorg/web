import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";

export async function getStaticPaths() {
  return (await getCollection("blog")).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title={post.data.title} description={post.data.description} path={`/blog/${post.id}`} image={post.data.image} imageAlt={post.data.imageAlt}>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main" class="wrap">
    <article class="post">
      <p class="meta"><a href="/blog">Blog</a>, <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time> · {post.data.author}</p>
      <h1>{post.data.title}</h1>
      <Content />
    </article>
  </main>
  <SiteFooter />
</Base>
<script>
  // Clips loop muted, but only start when the visitor allows motion, and
  // can always be paused (WCAG 2.2.2).
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  for (const clip of document.querySelectorAll<HTMLElement>("[data-clip]")) {
    const video = clip.querySelector("video");
    const toggle = clip.querySelector<HTMLButtonElement>("[data-clip-toggle]");
    if (!video || !toggle) continue;
    const label = () => (toggle.textContent = video.paused ? "Play" : "Pause");
    video.addEventListener("play", label);
    video.addEventListener("pause", label);
    toggle.addEventListener("click", () => (video.paused ? video.play() : video.pause()));
    toggle.hidden = false;
    if (!still) video.play().catch(label);
    label();
  }
</script>
<style>
  .post {
    max-width: 44rem;
    padding-block: 3rem 5rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .meta {
    color: var(--c-text-muted);
    font-size: 0.9375rem;
    margin: 0;
  }
  .meta a {
    color: inherit;
  }
  h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 2rem;
  }
  .post :global(h2) {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin: 2.5rem 0 0.75rem;
  }
  .post :global(pre) {
    background: var(--c-code-bg);
    color: var(--c-code-text);
    padding: 1rem 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .post :global(pre code) {
    font-family: var(--font-mono);
  }
  .post :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
  .post :global(a) {
    color: var(--c-link);
  }
  .post :global(figure) {
    margin: 2rem 0;
  }
  .post :global(figure img),
  .post :global(figure video) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    background: var(--c-code-bg);
  }
  .post :global(figcaption) {
    color: var(--c-text-muted);
    font-size: 0.9375rem;
    margin-top: 0.75rem;
  }
  .post :global([data-clip-toggle]) {
    font: inherit;
    font-size: 0.875rem;
    margin-top: 0.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid currentColor;
    border-radius: 6px;
    background: none;
    color: var(--c-text-muted);
    cursor: pointer;
  }
  .post :global(details) {
    margin: 1rem 0 2rem;
  }
  .post :global(summary) {
    cursor: pointer;
    color: var(--c-link);
  }
</style>
