import { isPublished } from "../../lib/published.js";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PageHero from "../../components/PageHero.astro";

const posts = (await getCollection("blog", (p) => isPublished(p))).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---
<Base title="Blog: Conn3x" description="Releases and notes from building Conn3x in public." path="/blog">
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main">
    <PageHero label="Blog" title="What we're shipping.">
      <p>Releases, and what we learned building them. <a href="/rss.xml">RSS</a></p>
    </PageHero>
    <div class="wrap blog">
    <ol class="posts">
      {posts.map((p, i) => (
        <li class:list={{ first: i === 0 }}>
          <a href={`/blog/${p.id}`}>
            <span class="text">
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{date(p.data.date)}</time>
              <h2>{p.data.title}</h2>
              <span class="d">{p.data.description}</span>
            </span>
            <img src={p.data.image ?? "/og.png"} alt="" width="1200" height="630" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
          </a>
        </li>
      ))}
    </ol>
    </div>
  </main>
  <SiteFooter />
</Base>
<style>
  .blog {
    padding-block: clamp(2.5rem, 6vw, 4rem) 0;
  }
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .posts li + li {
    border-top: 1px solid var(--c-border);
  }
  .posts a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 18rem;
    gap: 2.5rem;
    align-items: center;
    padding-block: 2rem;
    color: var(--c-text);
    text-decoration: none;
  }
  .first a {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    padding-top: 0;
  }
  .text {
    display: grid;
    gap: 0.6rem;
  }
  time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--c-text-muted);
  }
  h2 {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .first h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  a:hover h2 {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .d {
    color: var(--c-text-muted);
  }
  img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    transition: border-color 0.2s, transform 0.3s var(--ease-out);
  }
  a:hover img {
    border-color: var(--c-border-strong);
    transform: translateY(-2px);
  }
  @media (max-width: 760px) {
    .posts a,
    .first a {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
    img {
      order: -1;
    }
  }
</style>
