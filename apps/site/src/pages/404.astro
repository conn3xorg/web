import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---
<Base title="Page not found · Conn3x" description="This page doesn't exist." path="/404">
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />
  <main id="main" class="wrap missing">
    <h1>Page not found</h1>
    <p>There's nothing at this address. The site is small for now, so the home page has everything.</p>
    <p><a href="/">Go to the home page</a></p>
  </main>
  <SiteFooter />
</Base>

<style>
  .missing {
    padding-block: clamp(4rem, 12vw, 8rem);
    min-height: 50vh;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }
</style>
