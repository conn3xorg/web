import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { getCollection } from "astro:content";
import { isPublished } from "../lib/published.js";

const repo = "https://github.com/conn3xorg/conn3x";
const docs = "https://docs.conn3x.org";
const posts = (await getCollection("blog", (p) => isPublished(p)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const date = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const playbook = `- name: Install the basics
  ansible.builtin.package:
    name: "{{ item }}"
    state: present
  loop: [chrony, git, jq]`;
const circuit = `step "install_the_basics" {
  for_each = ["chrony", "git", "jq"]
  package {
    name = item.value
  }
}`;
---
<Base
  title="Conn3x: one plan for your cloud and the servers it creates"
  description="Conn3x is an open-source tool that creates cloud infrastructure and configures the servers on it, from one binary and one plan."
  path="/"
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="pitch">
          <h1><span>Provision it.</span> <span>Configure it.</span> <span>One plan.</span></h1>
          <p class="lede">
            Today that's Terraform, Ansible, and a drawer of glue scripts holding them
            together. Conn3x does both jobs: one binary, one plan, one state, for your cloud
            and every server it creates.
          </p>
          <div class="cta">
            <a class="button" href={`${docs}/get-started`}>Get started</a>
            <a class="secondary" href={repo}>Star it on GitHub</a>
            <p class="cta-note"><a href={`${repo}/releases/latest`}>v0.6 is out</a>. Open source, MPL-2.0, built in public.</p>
          </div>
        </div>

        <figure class="plan">
          <pre aria-describedby="plan-caption"><code><span class="l dim">$ conn3x plan</span>
<span class="l add">+ digitalocean_droplet.web</span>
<span class="l add">+ conn3x_package.web__nginx["web1"]</span>
<span class="l add">+ conn3x_file.web__page["web1"]</span>
<span class="l dim">    host = (known after apply)</span>
<span class="l add">+ conn3x_service.web__running["web1"]</span>
<span class="l dim">Plan: 4 to add, 0 to change, 0 to destroy.</span></code></pre>
          <figcaption id="plan-caption">
            Summarised from a real plan: the droplet, and the steps that set it up, waiting
            on an address that doesn't exist yet.
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="coming wrap" aria-labelledby="coming-title">
      <h2 id="coming-title">What it does</h2>
      <div class="points">
        <div>
          <h3>See everything before it runs</h3>
          <p>
            One plan shows the server you're about to create and the exact changes headed
            for it, line by line. Run it again later and it tells you what someone changed by
            hand.
          </p>
        </div>
        <div>
          <h3>Keep your providers</h3>
          <p>
            Conn3x is built on OpenTofu, so every Terraform and OpenTofu provider works as it
            is, and so do the modules and state you already have.
          </p>
        </div>
        <div>
          <h3>Install nothing on your servers</h3>
          <p>
            No Python, no agent. Conn3x connects over SSH, checks the host key every time, and
            runs plain shell commands, as root or through sudo.
          </p>
        </div>
        <div>
          <h3>Repeat a step for every item</h3>
          <p>
            <code>for_each</code> runs a step once per package, user or file, on every host. Drop
            an item and the next plan stops managing just that item, everywhere, or removes it
            from the hosts if you ask.
          </p>
        </div>
        <div>
          <h3>Keep secrets out of state</h3>
          <p>
            Write a password with <code>content_wo</code> and it reaches the server, not the plan
            or the state. State keeps an HMAC, so a hand edit still shows up.
          </p>
        </div>
        <div>
          <h3>Reach hosts behind a bastion</h3>
          <p>
            Chain jump hosts, or point at your SSH config and use its aliases. Each host can
            log in its own way, inside one circuit.
          </p>
        </div>
      </div>
      <p class="status">
        <a href={`${docs}/modules/package`}>Twenty-nine modules</a> so far, from packages and
        services to firewalld and SELinux. It's early, and Linux first: every change is tested
        on Rocky Linux 10, Fedora 45, Ubuntu 24.04 and Debian 13.
      </p>
    </section>

    <section class="convert" aria-labelledby="convert-title">
      <div class="wrap">
        <h2 id="convert-title">Bring your playbooks</h2>
        <p class="section-lede">
          <code>conn3x convert ansible -i inventory site.yml</code> rewrites each task it can prove
          means the same thing, loops over plain lists included. What it can't, a <code>when</code> or a
          Jinja filter, stays in the file with the reason, so nothing gets guessed.
        </p>
        <div class="pair">
          <figure>
            <figcaption>site.yml</figcaption>
            <pre><code>{playbook}</code></pre>
          </figure>
          <span class="junction" aria-hidden="true"></span>
          <figure>
            <figcaption>site.tf</figcaption>
            <pre><code>{circuit}</code></pre>
          </figure>
        </div>
      </div>
    </section>

    <section class="compare wrap" aria-labelledby="compare-title">
      <h2 id="compare-title">Two tools, or one</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col"></th><th scope="col">Terraform or OpenTofu, plus Ansible</th><th scope="col">Conn3x</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">To install</th><td>Two tools, and Python on the controller and every host</td><td>One binary</td></tr>
            <tr><th scope="row">State</th><td>Terraform state for the cloud, none for the hosts</td><td>One state for both</td></tr>
            <tr><th scope="row">Seeing host changes</th><td>A separate <code>--check --diff</code> run</td><td>In the same plan as the cloud</td></tr>
            <tr><th scope="row">Cloud addresses in host config</th><td>Inventory scripts or plugins</td><td>An expression</td></tr>
            <tr><th scope="row">Finding drift on hosts</th><td>Run the playbook in check mode</td><td><code>conn3x drift</code>, both layers</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="open" aria-labelledby="open-title">
      <div class="wrap">
        <h2 id="open-title">Built in the open, and not by one person</h2>
        <p class="section-lede">
          A clearer error, a permission check, a fix to the module reference: people outside
          the project wrote those, and they shipped in the next release with thanks in the notes.
          Small pull requests are how most of us started, and they're welcome here.
        </p>
        <div class="ways">
          <a href={`${repo}/issues?q=is%3Aopen+label%3A%22good+first+issue%22%2C%22help+wanted%22`}>
            <strong>Pick up an issue</strong>
            <span>Ones marked good first issue come with the files to touch and how to test.</span>
          </a>
          <a href="https://github.com/conn3xorg/web">
            <strong>Fix the docs</strong>
            <span>Every page has an edit link. Spotted something wrong? That's a pull request.</span>
          </a>
          <a href={`${repo}/issues/new/choose`}>
            <strong>Tell us what broke</strong>
            <span>A plan that surprised you is a bug report we want, with the output.</span>
          </a>
        </div>
        <p class="fine">
          Start with the <a href={`${repo}/blob/main/CONTRIBUTING.md`}>contributing guide</a>. It
          lists every check CI runs, so you can run them before you push.
        </p>
      </div>
    </section>

    {posts.length > 0 && (
      <section class="latest wrap" aria-labelledby="latest-title">
        <h2 id="latest-title">From the blog</h2>
        <ol>
          {posts.map((p) => (
            <li>
              <time datetime={p.data.date.toISOString().slice(0, 10)}>{date(p.data.date)}</time>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
              <p>{p.data.description}</p>
            </li>
          ))}
        </ol>
        <p class="fine"><a href="/blog">All posts</a></p>
      </section>
    )}

    <section class="closing wrap" aria-labelledby="closing-title">
      <h2 id="closing-title">Fifteen minutes to your first circuit</h2>
      <p>
        All you need is one Linux server you can reach over SSH. No server handy? Try it on a
        throwaway container with Podman or Docker, in about five.
      </p>
      <div class="cta">
        <a class="button" href={`${docs}/get-started`}>Get started</a>
        <a class="secondary" href={`${docs}/tutorials/try-locally`}>Try it locally</a>
        <a class="secondary" href={docs}>Read the docs</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .hero {
    background-image:
      linear-gradient(var(--c-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--c-grid) 1px, transparent 1px);
    background-size: 28px 28px;
    border-block: 1px solid var(--c-border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 6.2vw, 4.75rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  h1 span {
    display: block;
  }
  .lede {
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    color: var(--c-text-muted);
    max-width: 38rem;
    margin: 0 0 2rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
  .button {
    display: inline-block;
    background: var(--c-accent);
    color: var(--c-accent-contrast);
    font-weight: 700;
    text-decoration: none;
    padding: 0.85rem 1.35rem;
    border-radius: 8px;
  }
  .button:hover {
    transform: translateY(-1px);
  }
  .button:active {
    transform: translateY(0);
  }
  .secondary {
    color: var(--c-text);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .cta-note {
    flex-basis: 100%;
    margin: 0;
    color: var(--c-text-muted);
    font-size: 0.9375rem;
    max-width: 22rem;
  }
  .cta-note strong {
    color: var(--c-text);
  }

  .plan {
    margin: 0;
  }
  .plan pre {
    margin: 0;
    background: var(--c-code-bg);
    color: var(--c-code-text);
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.8125rem, 1.2vw, 0.9375rem);
    line-height: 1.75;
    overflow-x: auto;
  }
  .plan code {
    font-family: inherit;
  }
  .add {
    color: var(--c-code-add);
  }
  .chg {
    color: var(--c-code-change);
  }
  .dim {
    color: var(--c-code-dim);
  }
  .plan figcaption {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: var(--c-text-muted);
  }

  /* The one moment of motion: the plan prints line by line, once. */
  @media (prefers-reduced-motion: no-preference) {
    .button {
      transition: transform 0.15s ease;
    }
    .l {
      opacity: 0;
      animation: print 0.35s ease-out forwards;
    }
    .l:nth-child(2) { animation-delay: 0.45s; }
    .l:nth-child(3) { animation-delay: 0.7s; }
    .l:nth-child(4) { animation-delay: 0.95s; }
    .l:nth-child(5) { animation-delay: 1.2s; }
    .l:nth-child(6) { animation-delay: 1.45s; }
    .l:nth-child(7) { animation-delay: 1.85s; }
  }
  @keyframes print {
    from { opacity: 0; transform: translateX(-4px); }
    to { opacity: 1; transform: none; }
  }

  .coming {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .coming h2 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 2.5rem;
  }
  .points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
    border-top: 2px solid var(--c-text);
    padding-top: 2rem;
  }
  .points h3 {
    font-size: 1.1875rem;
    line-height: 1.25;
    margin: 0 0 0.6rem;
  }
  .points p {
    margin: 0;
    color: var(--c-text-muted);
  }
  .status {
    margin: 3rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--c-accent);
    max-width: 42rem;
  }

  @media (max-width: 900px) {
    .hero-grid,
    .points {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .section-lede {
    color: var(--c-text-muted);
    max-width: 44rem;
    margin: 0 0 2rem;
  }
  .convert {
    border-block: 1px solid var(--c-border);
    background: var(--c-surface);
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .convert h2,
  .compare h2,
  .closing h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
  }
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1.25fr);
    align-items: start;
  }
  .pair figure {
    margin: 0;
  }
  .pair figcaption {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--c-text-muted);
    margin-bottom: 0.5rem;
  }
  .pair pre {
    margin: 0;
    background: var(--c-code-bg);
    color: var(--c-code-text);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .pair code {
    font-family: var(--font-mono);
  }
  /* The brand's junction: a line with a node, joining the two halves. */
  .junction {
    height: 2px;
    background: var(--c-accent);
    position: relative;
    margin-top: 4.5rem;
  }
  .junction::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--c-accent);
    transform: translate(-50%, -50%);
  }
  .compare {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem 0.85rem 0;
    border-bottom: 1px solid var(--c-border);
  }
  thead th {
    font-weight: 700;
    color: var(--c-text-muted);
  }
  tbody th {
    font-weight: 600;
    width: 24%;
  }
  td:last-child,
  thead th:last-child {
    color: var(--c-text);
    font-weight: 700;
    border-left: 3px solid var(--c-accent);
    padding-left: 1rem;
  }
  td:nth-child(2) {
    color: var(--c-text-muted);
  }
  .open {
    border-block: 1px solid var(--c-border);
    background: var(--c-surface);
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .open h2,
  .latest h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.025em;
    margin: 0 0 1rem;
  }
  .ways {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ways a {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--c-border);
    border-top: 3px solid var(--c-accent);
    border-radius: 8px;
    background: var(--c-bg);
    color: var(--c-text);
    text-decoration: none;
  }
  .ways a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ways strong {
    display: block;
    margin-bottom: 0.4rem;
  }
  .ways span {
    color: var(--c-text-muted);
    font-size: 0.9375rem;
  }
  .fine {
    margin: 1.5rem 0 0;
    color: var(--c-text-muted);
  }
  .latest {
    padding-block: clamp(3rem, 7vw, 5rem) 0;
  }
  .latest ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    border-top: 2px solid var(--c-text);
    padding-top: 1.5rem;
  }
  .latest time {
    display: block;
    font-size: 0.875rem;
    color: var(--c-text-muted);
    margin-bottom: 0.35rem;
  }
  .latest li > a {
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--c-text);
  }
  .latest li p {
    margin: 0.5rem 0 0;
    color: var(--c-text-muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 900px) {
    .ways,
    .latest ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .closing {
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .closing p {
    color: var(--c-text-muted);
    margin: 0 0 1.5rem;
  }
  @media (max-width: 760px) {
    .pair {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
    .junction {
      width: 2px;
      height: 2rem;
      margin: 0.25rem auto;
    }
  }
</style>
