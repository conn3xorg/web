---
// Copyright (c) The Conn3x Authors
// SPDX-License-Identifier: MPL-2.0
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/home/Hero.astro";
import PlanFlow from "../components/home/PlanFlow.astro";
import DriftFlow from "../components/home/DriftFlow.astro";
import ConvertFlow from "../components/home/ConvertFlow.astro";
import Band from "../components/home/Band.astro";
import CircuitCards from "../components/home/CircuitCards.astro";
import { getCollection } from "astro:content";
import { isPublished } from "../lib/published.js";

const repo = "https://github.com/conn3xorg/conn3x";
const docs = "https://docs.conn3x.org";
const posts = (await getCollection("blog", (p) => isPublished(p)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const date = (d: Date) => d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

const features = [
  ["Keep your providers", "Built on OpenTofu, so every Terraform and OpenTofu provider works as it is, and so do your modules and state."],
  ["Install nothing on your servers", "No Python, no agent. Conn3x connects over SSH, checks the host key every time, and runs plain shell commands."],
  ["Repeat a step for every item", "<code>for_each</code> runs a step once per package, user or file. Drop an item and the next plan stops managing just that one."],
  ["Keep secrets out of state", "Write a password with <code>content_wo</code> and it reaches the server, not the plan or the state. State keeps an HMAC."],
  ["Reach hosts behind a bastion", "Chain jump hosts, or point at your SSH config and use its aliases. Each host can log in its own way."],
  ["Twenty-nine modules", "Packages, files, templates, services, users, cron, sysctl, mounts, firewalld, ufw, SELinux and more."],
];
const compare = [
  ["To install", "Two tools, and Python on the controller and every host", "One binary"],
  ["State", "Terraform state for the cloud, none for the hosts", "One state for both"],
  ["Seeing host changes", "A separate <code>--check --diff</code> run", "In the same plan as the cloud"],
  ["Cloud addresses in host config", "Inventory scripts or plugins", "An expression"],
  ["Finding drift on hosts", "Run the playbook in check mode", "<code>conn3x drift</code>, both layers"],
];
---
<Base
  title="Conn3x: one plan for your cloud and the servers it creates"
  description="Conn3x is an open-source tool that creates cloud infrastructure and configures the servers on it, from one binary and one plan."
  path="/"
>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader />

  <main id="main" class="home">
    <Hero />

    <section class="sec wrap" aria-labelledby="s1">
      <div class="sec-head">
        <p class="label"><span class="n">01</span> One plan</p>
        <h2 class="lead" id="s1"><strong>One plan for the cloud and the servers in it.</strong> Point a circuit at a resource and the plan shows the server about to be created next to every package, file and service headed for it.</h2>
      </div>
      <PlanFlow />
    </section>

    <section class="sec wrap" aria-labelledby="s2">
      <div class="sec-head">
        <p class="label"><span class="n">02</span> Drift</p>
        <h2 class="lead" id="s2"><strong>Hear about the 3 a.m. fix at breakfast.</strong> <code>conn3x drift</code> checks the cloud and the servers, and fails the job when either has moved.</h2>
      </div>
      <DriftFlow />
    </section>

    <section class="sec wrap" aria-labelledby="s3">
      <div class="sec-head">
        <p class="label"><span class="n">03</span> Bring your playbooks</p>
        <h2 class="lead" id="s3"><strong>Your playbooks come with you.</strong> The converter rewrites each task it can prove, and marks the rest with the reason. Nothing gets guessed.</h2>
      </div>
      <ConvertFlow />
    </section>

    <Band />

    <section class="sec wrap" aria-labelledby="s4">
      <div class="sec-head">
        <p class="label"><span class="n">04</span> Everyday work</p>
        <h2 class="lead" id="s4"><strong>Everything a server needs.</strong> Linux first: every change is tested on Rocky Linux 10, Fedora 45, Ubuntu 24.04 and Debian 13.</h2>
      </div>
      <ul class="features">
        {features.map(([t, d]) => (
          <li><h3>{t}</h3><p set:html={d} /></li>
        ))}
      </ul>
      <p class="more"><a href={`${docs}/modules/package`}>Every module in the docs →</a></p>
    </section>

    <section class="sec wrap" aria-labelledby="s5">
      <div class="sec-head">
        <p class="label"><span class="n">05</span> Circuits</p>
        <h2 class="lead" id="s5"><strong>Don't write the nginx setup again.</strong> Borrow a circuit with one <code>module</code> block, or share your own on the directory.</h2>
      </div>
      <CircuitCards />
      <p class="more"><a href="/circuits">Browse every circuit →</a></p>
    </section>

    <section class="sec wrap" aria-labelledby="s6">
      <div class="sec-head">
        <p class="label"><span class="n">06</span> Compare</p>
        <h2 class="lead" id="s6"><strong>Two tools, or one.</strong> The same job, with one less handoff.</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th scope="col"><span class="sr">Aspect</span></th><th scope="col">Terraform or OpenTofu, plus Ansible</th><th scope="col" class="us">Conn3x</th></tr>
          </thead>
          <tbody>
            {compare.map(([k, a, b]) => (
              <tr><th scope="row">{k}</th><td set:html={a} /><td class="us" set:html={b} /></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec wrap" aria-labelledby="s7">
      <div class="sec-head">
        <p class="label"><span class="n">07</span> Open source</p>
        <h2 class="lead" id="s7"><strong>Built with the people who use it.</strong> Every fix from outside the project ships with the name of whoever wrote it, right there in the release notes.</h2>
      </div>
      <div class="ways">
        <a href={`${repo}/issues?q=is%3Aopen+label%3A%22good+first+issue%22%2C%22help+wanted%22`}>
          <span class="label">Code</span>
          <strong>Pick up an issue</strong>
          <span class="d">Ones marked good first issue come with the files to touch and how to test.</span>
        </a>
        <a href="https://github.com/conn3xorg/web">
          <span class="label">Docs</span>
          <strong>Fix the docs</strong>
          <span class="d">Every page has an edit link. Spotted something wrong? That's a pull request.</span>
        </a>
        <a href={`${repo}/issues/new/choose`}>
          <span class="label">Feedback</span>
          <strong>Tell us what broke</strong>
          <span class="d">A plan that surprised you is a bug report we want, with the output.</span>
        </a>
      </div>
      <p class="fine">
        MPL-2.0, no CLA, and no feature held back for sponsors. <a href="/community">Meet the people</a>{" "}
        building it, or start with the <a href={`${repo}/blob/main/CONTRIBUTING.md`}>contributing guide</a>.
      </p>
    </section>

    {posts.length > 0 && (
      <section class="sec wrap" aria-labelledby="s8">
        <div class="blog-head">
          <h2 class="lead" id="s8"><strong>From the blog.</strong></h2>
          <a class="btn btn-ghost" href="/blog">All posts</a>
        </div>
        <ol class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>
                <img src={p.data.image ?? "/og.png"} alt="" width="600" height="315" loading="lazy" decoding="async" />
                <time datetime={p.data.date.toISOString().slice(0, 10)}>{date(p.data.date)}</time>
                <strong>{p.data.title}</strong>
                <span>{p.data.description}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    <section class="closing" aria-labelledby="close">
      <div class="wrap">
        <h2 id="close">Fifteen minutes to your<br />first circuit.</h2>
        <p>All you need is one Linux server you can reach over SSH. No server handy? Try it on a throwaway container, in about five.</p>
        <div class="cta">
          <a class="btn" href={`${docs}/get-started`}>Get started</a>
          <a class="btn btn-ghost" href={`${docs}/tutorials/try-locally`}>Try it locally</a>
          <a class="btn btn-ghost" href={docs}>Read the docs</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .sec-head code {
    font-size: 0.8em;
    color: var(--c-text);
  }
  .features {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-border);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .features li {
    background: var(--c-bg);
    padding: 2rem 1.75rem;
    transition: background 0.2s;
  }
  .features li:hover {
    background: var(--c-surface);
  }
  .features h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.4rem;
  }
  .features p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--c-text-muted);
    line-height: 1.55;
  }
  .more {
    margin: 1.25rem 0 0;
    font-size: 0.9375rem;
  }
  .more a,
  .fine a {
    color: var(--c-link);
  }
  .table-wrap {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    overflow-x: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    min-width: 40rem;
  }
  th,
  td {
    text-align: left;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--c-border);
    vertical-align: top;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  tbody th {
    font-weight: 600;
    width: 22%;
  }
  td {
    color: var(--c-text-muted);
  }
  .us {
    background: color-mix(in srgb, var(--c-accent) 7%, transparent);
    color: var(--c-text);
    font-weight: 600;
  }
  thead .us {
    color: var(--c-accent);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .ways {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ways a {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding: 1.5rem;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    background: var(--c-surface);
    color: var(--c-text);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s var(--ease-out);
  }
  .ways a:hover {
    border-color: var(--c-border-strong);
    transform: translateY(-2px);
  }
  .ways strong {
    font-size: 1.125rem;
    font-weight: 600;
    margin-top: 0.75rem;
  }
  .ways .d {
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }
  .fine {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }
  .blog-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
  }
  .posts {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .posts a {
    display: grid;
    gap: 0.5rem;
    color: var(--c-text);
    text-decoration: none;
  }
  .posts img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
  }
  .posts a:hover img {
    border-color: var(--c-border-strong);
  }
  .posts a:hover strong {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .posts time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--c-text-muted);
  }
  .posts strong {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .posts span {
    font-size: 0.9375rem;
    color: var(--c-text-muted);
  }
  .closing {
    margin-top: clamp(6rem, 12vw, 10rem);
    padding-block: clamp(5rem, 10vw, 8rem);
    border-block: 1px solid var(--c-border);
    background:
      radial-gradient(40rem 26rem at 85% 0%, color-mix(in srgb, var(--c-accent) 16%, transparent), transparent 70%),
      var(--c-surface);
  }
  .closing h2 {
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0;
  }
  .closing p {
    max-width: 34rem;
    color: var(--c-text-muted);
    font-size: 1.125rem;
    margin: 1.5rem 0 2rem;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 860px) {
    .features,
    .ways,
    .posts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
